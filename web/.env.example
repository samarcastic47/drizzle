# Copy to .env.local. All values are baked into the static export at build time.

# 1 = in-memory mock data (no chain, no wallet), 0/empty = NEAR testnet RPC
NEXT_PUBLIC_MOCK=1

# Deployments behind the Replay / Live toggle
NEXT_PUBLIC_REPLAY_CONTRACT=drizzle-replay.testnet
NEXT_PUBLIC_LIVE_CONTRACT=drizzle.testnet

# Optional RPC override
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org
